# ==============================================================================
# SahyogX Backend Configuration - Environment Template
# Copy this file to .env and adjust variables for your local setup.
# DO NOT commit real secrets or production credentials to Git.
# ==============================================================================

# Application Metadata
APP_NAME="SahyogX Backend API"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array of origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# PostgreSQL Database Configuration (PostgreSQL 17)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="YOUR_ACTUAL_PASSWORD"
POSTGRES_DB="sahyogx"

# Full Database URL (SQLAlchemy 2.0 Async + asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sahyogx"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# JWT Authentication Configuration
JWT_SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
